# OpenAI API Key (optional - app uses stock fallback images if not set)
OPENAI_API_KEY=your_openai_api_key_here

# Flask secret key (random per-process key is used if unset)
# SECRET_KEY=your_secret_key_here

# Token required (header X-Admin-Token) for POST /genseed. Endpoint is
# disabled when unset.
# ADMIN_TOKEN=change_me

# Cost controls for public image generation
# GENERATE_LIMIT_PER_HOUR=5     # per client IP
# DAILY_GENERATION_CAP=100      # total per UTC day, per worker process
# PROXY_HOPS=1                  # trusted reverse-proxy hops (for client IP)

# Image generation
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_TIMEOUT_SEC=45

# Google Analytics ID, loaded only after consent. Set empty to disable.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
